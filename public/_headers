/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self)
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.tile.openstreetmap.org https://maps.gstatic.com data: blob:; connect-src 'self' https://*.tile.openstreetmap.org https://api.openrouteservice.org https://nominatim.openstreetmap.org https://www.oref.org.il https://oref-proxy.galmc1986.workers.dev https://*.workers.dev https://maps.googleapis.com https://places.googleapis.com https://script.google.com https://script.googleusercontent.com; worker-src 'self'; font-src 'self' https://fonts.gstatic.com; frame-src 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/shelters.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400, must-revalidate
  Content-Type: application/json; charset=utf-8
  Content-Encoding: gzip
  Vary: Accept-Encoding

/index.html
  Cache-Control: public, max-age=300

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
