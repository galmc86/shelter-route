/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self)
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.tile.openstreetmap.org data:; connect-src 'self' https://api.openrouteservice.org https://nominatim.openstreetmap.org; font-src 'self'; frame-src 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/shelters.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/index.html
  Cache-Control: public, max-age=300

/favicon.svg
  Cache-Control: public, max-age=604800
